@page "/remote-mod-management"
@namespace Zmm.Zipmods
@using Zmm.Components
@inherits ZmmComponentBase

<MCard>
    <MCardTitle>
        远程模组服务
    </MCardTitle>
    <MCardSubtitle>
        <MRow>
            <MCol Cols="6">
                <MTextField Clearable @bind-Value="RequestInput.Name" Label="网址"/>
            </MCol>
            <MCol Cols="6">
                <MTextField Clearable @bind-Value="RequestInput.Identifier" Label="名称"/>
            </MCol>
        </MRow>
        <MRow>
            <MCol Cols="6">
                <MTextField Clearable @bind-Value="RequestInput.Version" Label="版本"/>
            </MCol>
            <MCol Cols="6">
                <MTextField Clearable @bind-Value="RequestInput.Author" Label="作者"/>
            </MCol>
        </MRow>
        <MRow>
            <MCol Cols="12">
                <MTextField Clearable @bind-Value="RequestInput.Content" Label="内容"/>
            </MCol>
        </MRow>
        <MRow>
            <MCol Cols="3">
                <BoolSelect @bind-Value="RequestInput.IsStudioMod" Label="工作室"/>
            </MCol>
            <MCol Cols="3">
                <BoolSelect @bind-Value="RequestInput.IsCharaMod" Label="人物"/>
            </MCol>
            <MCol Cols="3">
                <BoolSelect @bind-Value="RequestInput.IsMapMod" Label="地图"/>
            </MCol>
            <MCol Cols="3">
                <BoolSelect @bind-Value="RequestInput.IsDownload" Label="已下载"/>
            </MCol>
        </MRow>
    </MCardSubtitle>
    <MCardActions>
        <MButton OnClick="RefreshAsync">
            搜索
        </MButton>
        <MButton OnClick="ResetAsync">
            重置
        </MButton>
        <PModal Persistent
                Title="加载SideLoader"
                Width="500"
                OnSave="LoadRemoteModsAsync">
            <ActivatorContent>
                <MButton @attributes="@context.Attrs">加载SideLoader</MButton>
            </ActivatorContent>
            <ChildContent>
                <MCol Cols="12">
                    <MTextField @bind-Value="RemoteUrl"
                                Label="SideLoader地址"
                                Dense
                                Outlined
                                HideDetails="@("auto")"/>
                </MCol>
            </ChildContent>
        </PModal>

        <MButton OnClick="DownloadModsAsync">
            下载筛选的模组
        </MButton>
        <MButton OnClick="ImportModsFromJsonAsync">
            导入Json
        </MButton>
        <MButton OnClick="ExportModsToJsonAsync">
            导出Json
        </MButton>
    </MCardActions>
    <MCardText>

        <MDataTable
            TItem="ZipmodLinkDto"
            Headers="@Headers"
            Items="@Result.Items"
            Page="@CurrentPage"
            ShowExpand
            ItemKey="u => u.Id.ToString()"
            ItemsPerPage="@RequestInput.MaxResultCount"
            OnOptionsUpdate="@GetEntitiesAsync"
            ServerItemsLength="@((int)Result.TotalCount)"
            Loading="IsLoading"
            ResizeMode="DataTableResizeMode.Auto">

            <ItemColContent>

                @if (context.Header.Text == "Action")
                {
                    <MButton OnClick="@(u => DownloadModAsync(context.Item))">
                        下载
                    </MButton>
                }
                else if (context.Value is not null)
                {
                    @context.Value
                }
                else
                {
                    @context.ValueContent
                }
            </ItemColContent>
            <ExpandedItemContent>
                <td colspan="@Headers.Count">
                    <pre>
                        @context.Item.Info?.Content
                    </pre>
                </td>
            </ExpandedItemContent>
        </MDataTable>
    </MCardText>
</MCard>
